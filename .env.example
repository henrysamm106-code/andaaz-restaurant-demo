# GEMINI_API_KEY: Required for server-side Gemini AI calls (Ask Andaaz assistant).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional Gemini model ID for the Ask Andaaz chat assistant.
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Hosted URL injected at runtime.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Supabase project URL for persistent production & shared demo storage.
SUPABASE_URL=

# SUPABASE_ANON_KEY: Supabase anon/public project key (for RLS-protected client auth if enabled).
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Server-only Supabase service role key (never expose to browser).
SUPABASE_SERVICE_ROLE_KEY=

# N8N_CHAT_WEBHOOK_URL: Server-side webhook URL for the external n8n Chat Trigger / AI Agent.
N8N_CHAT_WEBHOOK_URL=

# N8N_STATUS_WEBHOOK_URL: Server-side webhook URL called when a manager approves, rejects, cancels, or reschedules.
N8N_STATUS_WEBHOOK_URL=

# N8N_INTEGRATION_SECRET: Bearer token required on incoming /api/integrations/n8n/* calls and outbound n8n webhooks.
N8N_INTEGRATION_SECRET=

# WHATSAPP_TEST_NUMBER: Optional test WhatsApp E.164 digits (without +) for the /automation-demo "Test on WhatsApp" flow.
WHATSAPP_TEST_NUMBER=

# WHATSAPP_CLOUD_API_CONFIGURED: Optional flag ("true") when external n8n + WhatsApp Cloud API delivery is live.
WHATSAPP_CLOUD_API_CONFIGURED=

# MANAGER_ACCESS_PASSCODE: Server-only passcode for accessing production /api/admin/* management endpoints.
MANAGER_ACCESS_PASSCODE=
